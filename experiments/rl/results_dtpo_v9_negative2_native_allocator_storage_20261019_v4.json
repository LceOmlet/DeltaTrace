  "native_CuMem_pool_source": {
    "path": "/opt/conda/lib/python3.12/site-packages/vllm/device_allocator/cumem.py",
    "SHA256": "da2b4bf1d22a00863cb6478dbc587a8c746a37a699b98297849e1dd531c3bf15",
    "excerpts": [
      {
        "line": 75,
        "text": ""
      },
      {
        "line": 76,
        "text": ""
      },
      {
        "line": 77,
        "text": "@contextmanager"
      },
      {
        "line": 78,
        "text": "def use_memory_pool_with_allocator("
      },
      {
        "line": 79,
        "text": "    python_malloc_fn: Callable[[int], int], python_free_func: Callable[[int, int], None]"
      },
      {
        "line": 80,
        "text": ") -> None:"
      },
      {
        "line": 81,
        "text": "    new_alloc = get_pluggable_allocator(python_malloc_fn, python_free_func)"
      },
      {
        "line": 82,
        "text": "    mem_pool = torch.cuda.memory.MemPool(new_alloc._allocator)"
      },
      {
        "line": 83,
        "text": "    with torch.cuda.memory.use_mem_pool(mem_pool):"
      },
      {
        "line": 84,
        "text": "        yield mem_pool, new_alloc"
      },
      {
        "line": 85,
        "text": ""
      },
      {
        "line": 86,
        "text": ""
      },
      {
        "line": 87,
        "text": "class CuMemAllocator:"
      },
      {
        "line": 88,
        "text": "    \"\"\""
      },
      {
        "line": 89,
        "text": "    A singleton class that manages a memory pool for CUDA tensors."
      },
      {
        "line": 90,
        "text": "    The memory in this pool can be offloaded or discarded when the"
      },
      {
        "line": 91,
        "text": "    allocator sleeps."
      },
      {
        "line": 92,
        "text": ""
      },
      {
        "line": 93,
        "text": "    Inside the `use_memory_pool(tag)` context, all tensors created will"
      },
      {
        "line": 94,
        "text": "    be allocated in the memory pool, and has the same tag as the"
      },
      {
        "line": 95,
        "text": "    tag passed to the context."
      },
      {
        "line": 96,
        "text": ""
      },
      {
        "line": 97,
        "text": "    When we call `sleep`, all tensors with the specified tag will be"
      },
      {
        "line": 98,
        "text": "    offloaded to CPU memory, and the rest of the tensors will be discarded."
      },
      {
        "line": 99,
        "text": "    When we call `wake_up`, all tensors that are previously offloaded"
      },
      {
        "line": 100,
        "text": "    will be loaded back to GPU memory, and the rest of the tensors will"
      },
      {
        "line": 101,
        "text": "    have empty memory."
      },
      {
        "line": 102,
        "text": ""
      },
      {
        "line": 103,
        "text": "    Why it needs to be a singleton?"
      },
      {
        "line": 104,
        "text": "    When allocated tensors are garbage collected, PyTorch will call"
      },
      {
        "line": 105,
        "text": "    the free callback, which will call the `python_free_callback` method."
      },
      {
        "line": 106,
        "text": "    The C-extension uses a global variable to store the function of an"
      },
      {
        "line": 107,
        "text": "    instance of this class. If we create multiple instances of this class,"
      },
      {
        "line": 108,
        "text": "    the global variable will be overwritten and the free callback will"
      },
      {
        "line": 109,
        "text": "    not work as expected."
      },
      {
        "line": 110,
        "text": "    \"\"\""
      },
      {
        "line": 111,
        "text": ""
      },
      {
        "line": 112,
        "text": "    instance: \"CuMemAllocator\" = None"
      },
      {
        "line": 247,
        "text": "                        data.cpu_backup_tensor = None"
      },
      {
        "line": 248,
        "text": ""
      },
      {
        "line": 249,
        "text": "    @contextmanager"
      },
      {
        "line": 250,
        "text": "    def use_memory_pool(self, tag: str | None = None):"
      },
      {
        "line": 251,
        "text": "        \"\"\""
      },
      {
        "line": 252,
        "text": "        A context manager to use the memory pool."
      },
      {
        "line": 253,
        "text": "        All memory allocation created inside the context will be allocated"
      },
      {
        "line": 254,
        "text": "        in the memory pool, and has the specified tag."
      },
      {
        "line": 255,
        "text": ""
      },
      {
        "line": 256,
        "text": "        :param tag: The tag of the memory allocation. If None, the default tag"
      },
      {
        "line": 257,
        "text": "            will be used."
      },
      {
        "line": 258,
        "text": "        \"\"\""
      },
      {
        "line": 259,
        "text": "        if tag is None:"
      },
      {
        "line": 260,
        "text": "            tag = CuMemAllocator.default_tag"
      },
      {
        "line": 261,
        "text": ""
      },
      {
        "line": 262,
        "text": "        assert isinstance(tag, str)"
      },
      {
        "line": 263,
        "text": ""
      },
      {
        "line": 264,
        "text": "        old_tag = self.current_tag"
      },
      {
        "line": 265,
        "text": "        self.current_tag = tag"
      },
      {
        "line": 266,
        "text": "        with use_memory_pool_with_allocator("
      },
      {
        "line": 267,
        "text": "            self.python_malloc_callback, self.python_free_callback"
      },
      {
        "line": 268,
        "text": "        ) as data:"
      },
      {
        "line": 269,
        "text": "            # start to hit another PyTorch bug in PyTorch 2.6,"
      },
      {
        "line": 270,
        "text": "            # possibly because of gc-related issue w.r.t. the allocator and"
      },
      {
        "line": 271,
        "text": "            # the memory pool."
      },
      {
        "line": 272,
        "text": "            # to avoid the issue, we keep a reference of the data."
      },
      {
        "line": 273,
        "text": "            # see https://github.com/pytorch/pytorch/issues/146431 ."
      },
      {
        "line": 274,
        "text": "            self.allocator_and_pools[tag] = data"
      },
      {
        "line": 275,
        "text": "            yield"
      },
      {
        "line": 276,
        "text": "            # PyTorch's bug, calling torch.cuda.empty_cache() will error"
      },
      {
        "line": 277,
        "text": "            # when using pluggable allocator, see"
      },
      {
        "line": 278,
        "text": "            # https://github.com/pytorch/pytorch/issues/145168 ."
      },
      {
        "line": 279,
        "text": "            # if we have some memory allocated and then freed,"
      }
    ]
  },
