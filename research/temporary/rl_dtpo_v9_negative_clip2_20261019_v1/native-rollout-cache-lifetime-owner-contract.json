      {
        "line": 103,
        "text": "            **kwargs: train_tp, for Megatron Backend to initialize hybrid engine (zero redundancy) process group"
      },
      {
        "line": 104,
        "text": "        \"\"\""
      },
      {
        "line": 105,
        "text": "        super().__init__()"
      },
      {
        "line": 106,
        "text": "        self.config = config"
      },
      {
        "line": 107,
        "text": "        assert not (not config.enforce_eager and config.free_cache_engine), \"disable CUDA graph (enforce_eager = False) if free cache engine\""
      },
      {
        "line": 108,
        "text": ""
      },
      {
        "line": 109,
        "text": "        tensor_parallel_size = self.config.get(\"tensor_model_parallel_size\", 1)"
