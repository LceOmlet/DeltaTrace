      {
        "line": 445,
        "text": "class vLLMAsyncRollout:"
      },
      {
        "line": 446,
        "text": "    \"\"\"vLLMAsyncRollout is a thin wrapper of WorkerWrapperBase,"
      },
      {
        "line": 447,
        "text": "    which is engine in single worker process."
      },
      {
        "line": 448,
        "text": "    \"\"\""
      },
      {
        "line": 468,
        "text": "        # inference engine is intialized now, update sharding manager"
      },
      {
        "line": 469,
        "text": "        self.sharding_manager.inference_engine = self.inference_engine"
      },
      {
        "line": 470,
        "text": "        self.sharding_manager.model_runner = self.inference_engine.worker.model_runner"
      },
      {
        "line": 471,
        "text": ""
      },
      {
        "line": 472,
        "text": "    def sleep(self, *args, **kwargs):"
      },
      {
        "line": 473,
        "text": "        \"\"\"Offload model weights and discard kv cache.\"\"\""
      },
      {
        "line": 474,
        "text": "        if self.is_sleep:"
      },
      {
        "line": 475,
        "text": "            return"
      },
      {
        "line": 476,
        "text": "        self.sharding_manager.__exit__(None, None, None)"
      },
      {
        "line": 477,
        "text": "        self.is_sleep = True"
      },
      {
        "line": 478,
        "text": ""
      },
      {
        "line": 479,
        "text": "    def wake_up(self, *args, **kwargs):"
      },
      {
        "line": 480,
        "text": "        \"\"\"Load model weights and build kv cache.\"\"\""
      },
      {
        "line": 481,
        "text": "        if not self.is_sleep:"
      },
      {
        "line": 482,
        "text": "            return"
      },
      {
        "line": 483,
        "text": "        self.sharding_manager.__enter__()  # pylint: disable=C2801"
      },
      {
        "line": 484,
        "text": "        self.is_sleep = False"
      },
      {
        "line": 485,
        "text": ""
      },
      {
        "line": 486,
        "text": "    def execute_method(self, method: Union[str, bytes], *args, **kwargs):"
      },
      {
        "line": 487,
        "text": "        if method == \"init_worker\":"
      },
      {
        "line": 488,
        "text": "            return self.init_worker(*args, **kwargs)"
      },
      {
        "line": 489,
        "text": "        elif method == \"load_model\":"
      },
      {
        "line": 490,
        "text": "            return self.load_model(*args, **kwargs)"
      },
      {
        "line": 491,
        "text": "        elif method == \"sleep\":"
      },
      {
        "line": 492,
        "text": "            return self.sleep(*args, **kwargs)"
      },
      {
        "line": 493,
        "text": "        elif method == \"wake_up\":"
      },
      {
        "line": 494,
        "text": "            return self.wake_up(*args, **kwargs)"
      },
      {
        "line": 495,
        "text": "        else:"
      },
      {
        "line": 496,
        "text": "            return self.inference_engine.execute_method(method, *args, **kwargs)"
      }
    ]
