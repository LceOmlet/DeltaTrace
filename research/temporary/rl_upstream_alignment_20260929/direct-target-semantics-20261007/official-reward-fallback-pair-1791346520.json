              "line": 103,
              "text": "def compute_reward(data: DataProto, reward_fn):"
            },
            {
              "line": 104,
              "text": "    \"\"\""
            },
            {
              "line": 105,
              "text": "    Compute reward for a batch of data."
            },
            {
              "line": 106,
              "text": "    Args:"
            },
            {
              "line": 107,
              "text": "        data: DataProto object containing the input data."
            },
            {
              "line": 108,
              "text": "        reward_fn: Reward function to compute the reward."
            },
            {
              "line": 109,
              "text": "    Returns:"
            },
            {
              "line": 110,
              "text": "        Tuple of reward tensor and extra info dictionary."
