            {
              "line": 114,
              "text": "        reward_tensor = reward_result[\"reward_tensor\"]"
            },
            {
              "line": 115,
              "text": "        reward_extra_infos_dict = reward_result[\"reward_extra_info\"]"
            },
            {
              "line": 116,
              "text": "    except Exception as e:"
            },
            {
              "line": 117,
              "text": "        print(f\"Error in reward_fn: {e}\")"
            },
            {
              "line": 118,
              "text": "        reward_tensor = reward_fn(data)"
            },
            {
              "line": 119,
              "text": "        reward_extra_infos_dict = {}"
            },
            {
              "line": 120,
              "text": ""
            },
            {
              "line": 121,
              "text": "    return reward_tensor, reward_extra_infos_dict"
            },
            {
