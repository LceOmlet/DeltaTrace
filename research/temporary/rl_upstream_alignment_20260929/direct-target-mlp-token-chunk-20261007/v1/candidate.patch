+def _chunk_mlp_tokens(op,chunk_size):
+    """Bound token-local finite temporaries; keep the existing MLP owner."""
+    def chunked(*args):
+        tokens=args[0].shape[1]
+        if tokens<=chunk_size:
+            return op(*args)
+        sources,weights=args[:7],args[7:]
+        result=None;start=0
+        for chunks in zip(*(value.split(chunk_size,dim=1) for value in sources)):
+            # Captured paired endpoints have original-T batch strides. Give
+            # the same dynamic owner compact chunk strides, not one guard
+            # variant for every trajectory length. Dtype and B are unchanged.
+            chunks=tuple(value.contiguous() for value in chunks)
+            part=op(*chunks,*weights)
+            if result is None:
+                result=part.new_empty((part.shape[0],tokens,part.shape[2]))
+            stop=start+part.shape[1]
+            result[:,start:stop].copy_(part)
+            start=stop
+            del part
+        return result
+    return chunked
+
