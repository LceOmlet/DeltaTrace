", \"attention_mask\", \"position_ids\", \"old_log_probs\", \"advantages\"]"}, {"line": 388, "text": "        if multi_turn:"}, {"line": 393, "text": "        has_multi_modal_inputs = \"multi_modal_inputs\" in data.non_tensor_batch.keys()"}, {"line": 394, "text": ""}, {"line": 395, "text": "        # Split to make minibatch iterator for updating the actor"}, {"line": 396, "text": "        # See PPO paper for details. https://arxiv.org/abs/1707.06347"}, {"line": 397, "text": "        if has_multi_modal_inputs:"}, {"line": 398, "text": "            num_mini_batches = data.batch.batch_size[0] // self.config.ppo_mini_batch_size"}, {"line": 399, "text": "            non_tensor_select_keys = [\"multi_modal_inputs\"]"}, {"line": 400, "text": "            dataloader = data.select(select_keys, non_tensor_select_keys).chunk(num_mini_batches)"}, {"line": 401, "text": "        else:"}, {"line": 402, "text": "            dataloader = batch.split(self.config.ppo_mini_batch_size)"}, {"line": 403, "text": ""}, {"line": 404, "text": "        metrics = {}"}, {"line": 405, "text": "        for epoch in range(self.config.ppo_epochs):"}, {"line": 406, "text": "            for batch_idx, data in enumerate(dataloader):"}, {"line": 407, "text": "                # split batch into micro_batches"}, {"line": 408, "text": "                mini_batch = data"}, {"line": 409, "text": "                if has_multi_modal_inputs:"}, {"line": 410, "text": "                    self.gradient_accumulation = self.config.ppo_mini_batch_size // self.config.ppo_micro_batch_size_per_gpu"}, {"line": 411, "text": "                    num_micro_batches = mini_batch.batch.batch_size[0] // self.config.ppo_micro_batch_size_per_gpu"}, {"line": 412, "text": "                    micro_batches = data.select(select_keys, non_tensor_select_keys).chunk(num_micro_batches)"}, {"line": 413, "text": "                elif self.config.use_dynamic_bsz:"}, {"line": 414, "text": "                    max_token_len = self.config.ppo_max_token_len_per_gpu * self.ulysses_sequence_parallel_size"}, {"line": 415, "text": "                    micro_batches, _ = rearrange_micro_batches(batch=mini_batch, max_token_len=max_token_len)"}, {"line": 416, "text": "                else:"}, {"line": 417, "text": "                    self.gradient_accumulation = self.config.ppo_mini_batch_size // self.config.ppo_micro_batch_size_per_gpu"}, {"line": 418, "text": "                    # split batch into micro_batches"}, {"line": 419, "text": "                    micro_batches = mini_batch.split(self.config.ppo_micro_batch_size_per_gpu)"}, {"line": 420, "text": ""}, {"line": 421, "text": "                self.actor_optimizer.zero_grad()"}, {"line": 422, "text": ""}, {"line": 423, "text": "                for data in micro_batches:"}, {"line": 424, "text": "                    # Support all hardwares"}, {"line": 425, "text": "                    if isinstance(data, DataProto):"}, {"line": 426, "text": "                        data = {**data.batch.to(get_torch_device().current_device()), **data.non_tensor_batch}"}, {"line": 427, "text": "                    else:"}, {"line": 428, "text": "                        data = data.to(get_torch_device().current_device())  # actor device is cpu when using offload"}, {"line": 429, "text": "                    responses = data[\"responses\"]"}, {"line": 430, "text": "                    response_length = responses.size(1)"}, {"line": 431, "text": "                    attention_mask = data[\"attention_mask\"]"}, {"line": 488, "text": "                        metrics[\"actor/kl_loss\"] = kl_loss.detach().item()"}, {"line": 489, "text": "                        metrics[\"actor/kl_coef\"] = self.config.kl_loss_coef"}, {"line": 490, "text": ""}, {"line": 491, "text": "                    if self.config.use_dynamic_bsz:"}, {"line": 492, "text": "                        # relative to the dynamic bsz"}, {"line": 493, "text": "                        loss = policy_loss * (len(data) / self.config.ppo_mini_batch_size)"}, {"line": 494, "text": "                    else:"}, {"line": 495, "text": "                        loss = policy_loss / self.gradient_accumulation"}, {"line": 496, "text": "                    loss.backward()"}, {"line": 497, "text": ""}, {"line": 498, "text": "                    data = {"}, {"line": 499, "text": "                        \"actor/pg_loss\": pg_loss.detach().item(),"}, {"line": 500, "text": "                        \"actor/pg_clipfrac\": pg_clipfrac.detach().item(),"}, {"line": 501, "text": "                        \"actor/ppo_kl\": ppo_kl.detach().item(),"}, {"line": 502, "text": "                        \"actor/pg_clipfrac_lower\": pg_clipfrac_lower.detach().item(),"}, {"line": 503, "text": "                    }"}]}, "/mnt/si0021787ci2/default/lzq/deepresearch/deltatrace_rl_20260922/candidates/appworld-fresh-official-padding-20261007-v1/verl/verl/trainer/ppo/ray_trainer.py": {"sha256": "d35ddd26b7497b153cec22f22e92eb1a08ef70385428dcbdcc37e879d9f16a4f", "selected_lines": [{"line": 61, "text": "from verl.utils.torch_functional import masked_mean"}, {"line": 62, "text": "from verl.utils.tracking import ValidationGenerationsLogger"}, {"line": 63, "text": "from verl.workers.rollout.async_server import AsyncLLMServerManager"}, {"line": 64, "text": "from gigpo import core_gigpo"}, {"line": 65, "text": ""}, {"line": 66, "text": "from agent_system.multi_turn_rollout import TrajectoryCollector, adjust_batch"}, {"line": 67, "text": ""}, {"line": 68, "text": "WorkerType = Type[Worker]"}, {"line": 69, "text": ""}, {"line": 70, "text": ""}, {"line": 71, "text": "class Role(Enum):"}, {"line": 72, "text": "    \"\"\""}, {"line": 73, "text": "    To create more roles dynamically, you can subclass Role and add new members"}, {"line": 74, "text": "    \"\"\""}, {"line": 241, "text": "    response_length = responses.size(1)"}, {"line": 242, "text": "    attention_mask = data.batch.get(\"loss_mask\", data.batch[\"attention_mask\"])"}, {"line": 243, "text": "    return attention_mask[:, -response_length:]"}, {"line": 244, "text": ""}, {"line": 245, "text": ""}, {"line": 246, "text": "def compute_advantage(data: DataProto, adv_estimator, gamma=1.0, lam=1.0, num_repeat=1, multi_turn=False, norm_adv_by_std_in_grpo=True, step_advantage_w=1.0, gigpo_mode=\"mean_std_norm\", gigpo_enable_similarity=False, gigpo_similarity_thresh=0.95, **kwargs):"}, {"line": 247, "text": "    \"\"\"Compute advantage estimates for policy optimization."}, {"line": 248, "text": ""}, {"line": 249, "text": "    This function computes advantage estimates using various estimators like GAE, GRPO, REINFORCE++, etc."}, {"line": 250, "text": "    The advantage estimates are used to guide policy optimization in RL algorithms."}, {"line": 251, "text": ""}, {"line": 252, "text": "    Args:"}, {"line": 253, "text": "        data (DataProto): The data containing batched model outputs and inputs."}, {"line": 254, "text": "        adv_estimator: The advantage estimator to use (e.g., GAE, GRPO, REINFORCE++)."}, {"line": 255, "text": "        gamma (float, optional): Discount factor for future rewards. Defaults to 1.0."}, {"line": 256, "text": "        lam (float, optional): Lambda parameter for GAE. Defaults to 1.0."}, {"line": 257, "text": "        num_repeat (int, optional): Number of times to repeat the computation. Defaults to 1."}, {"line": 258, "text": "        multi_turn (bool, optional): Whether the data is from a multi-turn conversation. Defaults to False."}, {"line": 259, "text": "        norm_adv_by_std_in_grpo (bool, optional): Whether to normalize advantages by standard deviation in GRPO. Defaults to True."}, {"line": 260, "text": ""}, {"line": 261, "text": "    Returns:"}, {"line": 262, "text": "        DataProto: The updated data with computed advantages and returns."}, {"line": 263, "text": "    \"\"\""}, {"line": 264, "text": "    # Back-compatible with trainers that do not compute response mask in fit"}, {"line": 265, "text": "    if \"response_mask\" not in data.batch:"}, {"line": 506, "text": ""}, {"line": 507, "text": "                if mbs is not None and mbs_per_gpu is not None:"}, {"line": 508, "text": "                    raise ValueError(f\"[{name}] You have set both '{name}.{param}' AND '{name}.{param_per_gpu}'. Please remove '{name}.{param}' because only '*_{param_per_gpu}'\" + \"is supported (the former is deprecated).\")"}, {"line": 509, "text": ""}, {"line": 510, "text": "        if not config.actor_rollout_ref.actor.use_dynamic_bsz:"}, {"line": 511, "text": "            # actor: ppo_micro_batch_size vs. ppo_micro_batch_size_per_gpu"}, {"line": 512, "text": "            check_mutually_exclusive("}, {"line": 513, "text": "                config.actor_rollout_ref.actor.ppo_micro_batch_size,"}, {"line": 514, "text": "                config.actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu,"}, {"line": 515, "text": "                \"actor_rollout_ref.actor\","}, {"line": 516, "text": "            )"}, {"line": 517, "text": ""}, {"line": 518, "text": "            if self.use_reference_policy:"}, {"line": 519, "text": "                # reference: log_prob_micro_batch_size vs. log_prob_micro_batch_size_per_gpu"}, {"line": 520, "text": "                check_mutually_exclusive("}, {"line": 521, "text": "                    config.actor_rollout_ref.ref.log_prob_micro_batch_size,"}, {"line": 522, "text": "                    config.actor_rollout_ref.ref.log_prob_micro_batch_size_per_gpu,"}, {"line": 530, "text": "                \"actor_rollout_ref.rollout\","}, {"line": 531, "text": "            )"}, {"line": 532, "text": ""}, {"line": 533, "text": "        if self.use_critic and not config.critic.use_dynamic_bsz:"}, {"line": 534, "text": "            # Check for critic micro-batch size conflicts"}, {"line": 535, "text": "            check_mutually_exclusive(config.critic.ppo_micro_batch_size, config.critic.ppo_micro_batch_size_per_gpu, \"critic\")"}, {"line": 536, "text": ""}, {"line": 537, "text": "        # Check for reward model micro-batch size conflicts"}, {"line": 538, "text": "        if config.reward_model.enable and not config.reward_model.use_dynamic_bsz:"}, {"line": 539, "text": "            check_mutually_exclusive(config.reward_model.micro_batch_size, config.reward_model.micro_batch_size_per_gpu, \"reward_model\")"}, {"line": 540, "text": ""}, {"line": 541, "text": "        # Actor"}, {"line": 542, "text": "        # check if train_batch_size is larger than ppo_mini_batch_size"}, {"line": 543, "text": "        # if NOT dynamic_bsz, we must ensure:"}, {"line": 544, "text": "        #    ppo_mini_batch_size is divisible by ppo_micro_batch_size"}, {"line": 545, "text": "        #    ppo_micro_batch_size * sequence_parallel_size >= n_gpus"}, {"line": 546, "text": "        if not config.actor_rollout_ref.actor.use_dynamic_bsz:"}, {"line": 547, "text": "            # assert config.data.train_batch_size >= config.actor_rollout_ref.actor.ppo_mini_batch_size"}, {"line": 548, "text": "            sp_size = config.actor_rollout_ref.actor.get(\"ulysses_sequence_parallel_size\", 1)"}, {"line": 549, "text": "            if config.actor_rollout_ref.actor.ppo_micro_batch_size is not None:"}, {"line": 550, "text": "                assert config.actor_rollout_ref.actor.ppo_mini_batch_size % config.actor_rollout_ref.actor.ppo_micro_batch_size == 0"}, {"line": 551, "text": "                assert config.actor_rollout_ref.actor.ppo_micro_batch_size * sp_size >= n_gpus"}, {"line": 552, "text": ""}, {"line": 553, "text": "        assert config.actor_rollout_ref.actor.loss_agg_mode in ["}, {"line": 554, "text": "            \"token-mean\","}, {"line": 555, "text": "            \"seq-mean-token-sum\","}, {"line": 556, "text": "            \"seq-mean-token-mean\","}, {"line": 557, "text": "            \"seq-mean-token-sum-norm\","}, {"line": 558, "text": "        ], f\"Invalid loss_agg_mode: {config.actor_rollout_ref.actor.loss_agg_mode}\""}, 