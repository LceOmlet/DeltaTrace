.max_memory_allocated() / (1024**3)"}, {"line": 633, "text": "            metrics[\"perf/max_memory_reserved_gb\"] = get_torch_device().max_memory_reserved() / (1024**3)"}, {"line": 634, "text": "            metrics[\"perf/cpu_memory_used_gb\"] = psutil.virtual_memory().used / (1024**3)"}, {"line": 635, "text": ""}, {"line": 636, "text": "            lr = self.actor_lr_scheduler.get_last_lr()[0]"}, {"line": 637, "text": "            metrics[\"actor/lr\"] = lr"}, {"line": 638, "text": "            self.actor_lr_scheduler.step()"}, {"line": 639, "text": ""}, {"line": 891, "text": "        # set FSDP offload params"}, {"line": 892, "text": "        self._is_offload_param = self.config.model.fsdp_config.param_offload"}, {"line": 893, "text": "        self._is_offload_optimizer = self.config.model.fsdp_config.optimizer_offload"}, {"line": 894, "text": ""}, {"line": 895, "text": "        # normalize config"}, {"line": 896, "text": "        self.config.ppo_mini_batch_size *= self.config.rollout_n"}, {"line": 897, "text": "        self.config.ppo_mini_batch_size //= torch.distributed.get_world_size() // self.ulysses_sequence_parallel_size"}, {"line": 898, "text": "        if self.config.ppo_micro_batch_size is not None:"}, {"line": 899, "text": "            self.config.ppo_micro_batch_size //= torch.distributed.get_world_size() // self.ulysses_sequence_parallel_size"}, {"line": 900, "text": "            self.config.forward_micro_batch_size //= torch.distributed.get_world_size() // self.ulysses_sequence_parallel_size"}, {"line": 901, "text": "            self.config.ppo_micro_batch_size_per_gpu = self.config.ppo_micro_batch_size"}, {"line": 902, "text": "            self.config.forward_micro_batch_size_per_gpu = self.config.forward_micro_batch_size"}, {"line": 903, "text": ""}, {"line": 904, "text": "        if self.config.ppo_micro_batch_size_per_gpu is not None:"}, {"line": 905, "text": "            assert self.config.ppo_mini_batch_size % self.config.ppo_micro_batch_size_