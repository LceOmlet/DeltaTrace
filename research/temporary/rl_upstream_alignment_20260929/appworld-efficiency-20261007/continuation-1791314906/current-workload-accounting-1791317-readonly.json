elf.ulysses_sharding_manager.postprocess_data(data=output)"}, {"line": 1161, "text": ""}, {"line": 1440, "text": ""}, {"line": 1441, "text": "    @register(dispatch_mode=Dispatch.DP_COMPUTE_PROTO)"}, {"line": 1442, "text": "    def compute_rm_score(self, data: DataProto):"}, {"line": 1443, "text": "        import itertools"}, {"line": 1444, "text": ""}, {"line": 1445, "text": "        from verl.utils.seqlen_balancing import get_reverse_idx, rearrange_micro_batches"}, {"line": 1446, "text": ""}, {"line": 1447, "text": "        # Support all hardwares"}, {"line": 1448, "text": "        data = data.to(get_torch_device().current_device())"}, {"line": 1449, "text": "        if self._do_switch_chat_template:"}, {"line": 1450, "text": "            rm_data = self._switch_chat_template(data)"}, {"line": 1451, "text": "        else:"}, {"line": 1452, "text": "            rm_input_ids = data.batch[\"input_ids\"]"}, {"line": 1453, "text": "            rm_attention_mask = data.batch[\"attention_mask\"]"}, {"line": 1468, "text": "            data = self.ulysses_sharding_manager.preprocess_data(data=data)"}, {"line": 1469, "text": ""}, {"line": 1470, "text": "            use_dynamic_bsz = self.config.use_dynamic_bsz"}, {"line": 1471, "text": "            if use_dynamic_bsz:"}, {"line": 1472, "text": "                max_token_len = self.config.forward_max_token_len_per_gpu * self.ulysses_sequence_parallel_size"}, {"line": 1473, "text": "                micro_batches, indices = rearrange_micro_batches(batch=rm_data.batch, max_token_len=max_token_len)"}, {"line": 1474, "text": "            else:"}, {"line": 1475, "text": "                micro_batches = rm_data.batch.split(self.config.micro_batch_size_per_gpu)"}, {"line": 1476, "text": "            output = []"}, {"line": 1477, "text": "            for micro_batch in micro_batches:"}, {"line": 1478, "text": "                rm_score = self._forward_micro_batch(micro_batch)"}, {"line": 1479, "text": "                output.append(rm_score)"}, {"line": 1480, "text": "            scores = torch.cat(output, dim=0)  # (batch_size)"}, {"line": 1481, "text": ""}, {"line": 1482, "text": "            if use_dynamic_bsz:"}, {"line": 1483, "text": "                indices = list(itertools.chain.from_iterable(indices))"}, {"line": 1484, "text": "                assert len(indices) == scores.size(0), f\"{len(indices)} vs. {scores.size()}\""}, {"line": 1485, "text": "                revert_indices = torch.tensor(get_reverse_idx(indices), dtype=torch.long)"}]}}}
