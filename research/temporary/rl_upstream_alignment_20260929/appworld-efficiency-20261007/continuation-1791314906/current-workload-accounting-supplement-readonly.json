_size"}, {"line": 97, "text": "    size_divisor = np.lcm.reduce(np.array([size_divisor_ref, size_divisor_rollout, size_divisor_actor])).item()"}, {"line": 98, "text": ""}, {"line": 99, "text": "    # check if the batch size is divisible by the dp size, if not, delete the last few samples to make it divisible"}, {"line": 100, "text": "    bs = len(data)"}, {"line": 101, "text": "    remainder = bs % size_divisor"}, {"line": 102, "text": "    if remainder == 0:"}, {"line": 103, "text": "        return data"}, {"line": 104, "text": "    "}, {"line": 105, "text": "    if mode == \"delete\":"}, {"line": 106, "text": "        # Generate indices to remove, rather than indices to keep"}, {"line": 107, "text": "        remove_indices = np.random.choice(bs, remainder, replace=False)"}, {"line": 108, "text": "        # Sort remove_indices to maintain stability when deleting"}, {"line": 109, "text": "        remove_indices = np.sort(remove_indices)"}, {"line": 110, "text": "        "}, {"line": 111, "text": "        # Create a boolean mask for elements to keep"}, {"line": 112, "text": "        keep_mask = np.ones(bs, dtype=bool)"}, {"line": 113, "text": "        keep_mask[remove_indices] = False"}, {"line": 114, "text": ""}, {"line": 115, "text": "        keep_mask_tensor = torch.tensor(keep_mask, dtype=torch.bool, device=data.batch['input_ids'].device)"}, {"line": 116, "text": "        # Apply the mask to keep elements in their original order"}, {"line": 117, "text": "        tensor_data = data.batch[keep_mask_tensor]"}, {"line": 118, "text": "        non_tensor_data = {key: val[keep_mask] for key, val in data.non_tensor_batch.items()}"}, {"line": 119, "text": "        adjusted_batch = DataProto(batch=tensor_data, non_tensor_batch=non_tensor_data, meta_info=data.meta_info)"}, {"line": 120, "text": "        del data"}, {"line": 121, "text": "    elif mode == \"copy\":"}, {"line": 122, "text": "        to_add = size_divisor - remainder"}, {"line": 123, "text": "        dup_indices = np.random.choice(bs, to_add, replace=False)"}, {"line": 124, "text": "        dup_proto = data.select_idxs(dup_indices)"}, {"line": 125, "text": ""}, {"line": 126, "text": "        adjusted_batch = DataProto.concat([data, dup_proto])"}, {"line": 127, "text": "    else:"}, {"line": 128, "text": "        raise ValueError(f\"Unsupported mode: {mode}\")"}, {"line": 129, "text": ""}, {"line": 130, "text": "    return adjusted_batch"}]}, "/mnt/si0021787ci2/default/lzq/deepresearch/deltatrace_rl_20260922/candidates/appworld-fresh-official-padding-20261007-v1/verl/verl/trainer/config/ppo_trainer.yaml": {"sha256": "e2ad9ebd91b2d9184528fef0ebb1998ff07b77bc29941f9573393977e654a8fb", "lines": [{"line": 230, "text": "custom_reward_function:"}, {"line": 231, "text": "  path: null"}, {"line": 232, "text": "  name: compute_score"}, {"line": 233, "text": ""}, {"line": 234, "text": "algorithm:"}, {"line": 235, "text": "  gamma: 1.0"}, {"line": 236, "text": "  lam: 1.0"}, {"line": 237, "text": "  adv_estimator: gae"}, {"line": 238, "text": "  norm_adv_by_std_in_grpo: True"}, {"line": 239, "text": "  use_kl_in_reward: False"}, {"line": 240, "text": "  kl_penalty: kl  # how to estimate kl divergence"}, {"line": 241, "text": "  kl_ctrl:"}, {"line": 242, "text": "    type: fixed"}, {"line": 243, "text": "    kl_coef: 0.001"}, {"line": 244, "text": "    horizon: 10000"}, {"line": 245, "text": "    target_kl: 0.1"}, {"line": 246, "text": "  use_pf_ppo: False"}, {"line": 247, "text": "  pf_ppo:"}, {"line": 248, "text": "    reweight_method: pow  # [\"pow\", \"max_min\", \"max_random\"]"}, {"line": 249, "text": "    weight_pow: 2.0"}, {"line": 250, "text": "  gigpo:"}, {"line": 251, "text": "    step_advantage_w: 1.0"}, {"line": 252, "text": "    mode: \"mean_norm\" # \"mean_norm\" or \"mean_std_norm\""}, {"line": 253, "text": "    enable_similarity: False # whether to use similarity-based anchor state grouping in GiGPO (supported for text-only tasks)"}, {"line": 254, "text": "    similarity_thresh: 0.95 # similarity threshold for GiGPO (0.0, 1.0)"}, {"line": 255, "text": "  filter_groups: # DAPO from https://arxiv.org/abs/2503.14476"}, {"line": 256, "text": "    enable: False"}, {"line": 257, "text": "    max_num_gen_batches: 10"}, {"line": 258, "text": ""}, {"line": 259, "text": "trainer:"}, {"line": 260, "text": "  balance_batch: True"}, {"line": 261, "text": "  total_epochs: 30"}, {"line": 262, "text": "  total_training_steps: null"}, {"line": 263, "text": "  project_name: verl_examples"}, {"line": 264, "text": "  experiment_name: gsm8k"}, {"line": 265, "text": "  logger: [ 'console', 'wandb' ]"}, {"line": 266, "text": "  log_val_generations: 0"}, {"line": 267, "text": "  rollout_data_dir: null # directory for logging the rollout data, no dump if null"}, {"line": 268, "text": "  validation_data_dir: null # directory for logging the validation data, no dump if null"}, {"line": 269, "text": "  nnodes: 1"}, {"line": 270, "text": "  n_gpus_per_node: 8"}, {"line": 271, "text": "  save_freq: -1"}, {"line": 272, "text": "  # auto: find the last ckpt to resume. If can't find, start from scratch"}, {"line": 273, "text": "  resume_mode: auto # or disable or resume_path if resume_from_path is set"}, {"line": 274, "text": "  resume_from_path: null"}, {"line": 275, "text": "  val_before_train: True"}, {"line": 276, "text": "  val_only: False"}, {"line": 277, "text": "  test_freq: -1"}, {"line": 278, "text": "  critic_warmup: 0"}, {"line": 279, "text": "  default_hdfs_dir: null"}, {"line": 280, "text": "  del_local_ckpt_after_load: False"}, {"line": 281, "text": "  default_local_dir: checkpoints/${trainer.project_name}/${trainer.experiment_name}"}, {"line": 282, "text": "  max_actor_ckpt_to_keep: null"}, {"line": 283, "text": "  max_critic_ckpt_to_keep: null"}, {"line": 284, "text": "  # The timeout for ray worker group to wait for the register center to be ready"}, {"line": 285, "text": "  ray_wait_register_center_timeout: 300"}, {"line": 286, "text": "  device: cuda"}, {"line": 287, "text": ""}, {"line": 288, "text": "ray_init:"}, {"line": 289, "text": "  num_cpus: null # `None` means using all CPUs, which might cause hang if limited in systems like SLURM. Please set to a number allowed then."}, {"line": 290, "text": ""}, {"line": 291, "text": ""}, {"line": 292, "text": "env:"}, {"line": 293, "text": "  env_name: alfworld/AlfredTWEnv"}, {"line": 294, "text": "  seed: 0"}, {"line": 295, "text": "  max_steps: 50"}, {"line": 296, "text": "  history_length: 2"}, {"line": 297, "text": "  resources_per_worker: # resources for each env worker"}, {"line": 298, "text": "    num_cpus: 0.1"}, {"line": 299, "text": "    num_gpus: 0"}, {"line": 300, "text": "  rollout:"}, {"line": 301, "text": "    n: 1 # the group number of envs (for GRPO and GiGPO)."}, {"line": 302, "text": "  alfworld:"}, {"line": 303, "text": "    eval_dataset: eval_in_distribution"}, {"line": 304, "text": "  search:"}, {"line": 305, "text": "    log_requests: false"}, {"line": 306, "text": "    search_url: \"http://127.0.0.1:8000/retrieve\" # also support multiple urls: [\"http://127.0.0.1:8000/retrieve\", \"http://127.0.0.1:8001/retrieve\"]"}, {"line": 307, "text": "    topk: 3"}, {"line": 308, "text": "    timeout: 60"}, {"line": 309, "text": "  sokoban:"}, {"line": 310, "text": "    dim_room: [6, 6]"}, {"line": 311, "text": "    num_boxes: 1"}, {"line": 312, "text": "    search_depth: 30"}, {"line": 313, "text": "    mode: tiny_rgb_array"}, {"line": 314, "text": "  webshop:"}, {"line": 315, "text": "    use_small: True"}, {"line": 316, "text": "    human_goals: False"}]}, "/mnt/si0021787ci2/default/lzq/deepresearch/deltatrace_rl_20260922/candidates/appworld-fresh-official-padding-20261007-v1/verl/verl/workers/actor/dp_actor.py": {"sha256": "3a65e173300be82a7a9e056a96227c4f746eabc3be778ef41c8d50138d52ce6c", "lines": [{"line": 425, "text": "                    if isinstance(data, DataProto):"}, {"line": 426, "text": "                        data = {**data.batch.to(get_torch_device().current_device()), **data.non_tensor_batch}"}, {"line": 427, "text": "                    else:"}, {"line": 428, "text": "                        data = data.to(get_torch_device().current_device())  # actor device is cpu when using offload"}, {"line": 429, "text": "                    responses = data[\"responses\"]"}, {"line": 430, "text": "                    response_length = responses.size(1)"}, {"line": 431, "text": "                    attention_mask = data[\"attention_mask\"]"}, {"line": 432, "text": "                    if multi_turn:"}, {"line": 433, "text": "                        response_mask = data[\"loss_mask\"][:, -response_length:]"}, {"line": 434, "text": "                    else:"}, {"line": 435, "text": "                        response_mask = attention_mask[:, -response_length:]"}, {"line": 436, "text": ""}, {"line": 437, "text": "                    old_log_prob = data[\"old_log_probs\"]"}, {"line": 438, "text": "                    advantages = data[\"advantages\"]"}, {"line": 439, "text": ""}, {"line": 440, "text": "                    clip_ratio = self.config.clip_ratio"}, {"line": 441, "text": "                    clip_ratio_low = self.config.clip_ratio_low if self.config.clip_ratio_low is not None else clip_ratio"}, {"line": 442, "text": "                    clip_ratio_high = self.config.clip_ratio_high if self.config.clip_ratio_high is not None else clip_ratio"}, {"line": 443, "text": "                    clip_ratio_c = self.config.get(\"clip_ratio_c\", 3.0)"}, {"line": 444, "text": "                    entropy_coeff = self.config.entropy_coeff"}, {"line": 445, "text": "                    loss_agg_mode = self.config.loss_agg_mode"}, {"line": 446, "text": ""}, {"line": 447, "text": "                    # all return: (bsz, response_length)"}, {"line": 448, "text": "                    calculate_entropy = False"}, {"line": 449, "text": "                    if entropy_coeff != 0:"}, {"line": 450, "text": "                        calculate_entropy = True"}, {"line": 451, "text": "                    entropy, log_prob = self._forward_micro_batch(micro_batch=data, temperature=temperature, calculate_entropy=calculate_entropy)"}, {"line": 452, "text": "                    "}, {"line": 453, "text": "                    loss_mode = self.config.policy_loss.get(\"loss_mode\", \"vanilla\")"}, {"line": 454, "text": "                    if loss_mode == \"vanilla\":"}, {"line": 455, "text": "                        policy_loss_fn = compute_policy_loss"}, {"line": 456, "text": "                    elif loss_mode == \"gspo\":"}, {"line": 457, "text": "                        policy_loss_fn = compute_policy_loss_gspo"}, {"line": 458, "text": "                    else:"}, {"line": 459, "text": "                        raise ValueError(f\"Unsupported loss_mode: {loss_mode}\")"}, {"line": 460, "text": ""}, {"line": 461, "text": "                    pg_loss, pg_clipfrac, ppo_kl, pg_clipfrac_lower = policy_loss_fn("}, {"line": 462, "text": "                        old_log_prob=old_log_prob,"}, {"line": 463, "text": "                        log_prob=log_prob,"}, {"line": 464, "text": "                        advantages=advantages,"}, {"line": 465, "text": "                        response_mask=response_mask,"}, {"line": 466, "text": "                        cliprange=clip_ratio,"}, {"line": 467, "text": "                        cliprange_low=clip_ratio_low,"}, {"line": 468, "text": "                        cliprange_high=clip_ratio_high,"}, {"line": 469, "text": "                        clip_ratio_c=clip_ratio_c,"}, {"line": 470, "text": "                        loss_agg_mode=loss_agg_mode,"}, {"line": 471, "text": "                    )"}, {"line": 472, "text": ""}, {"line": 473, "text": "                    if entropy_coeff != 0:"}, {"line": 474, "text": "                        entropy_loss = agg_loss(loss_mat=entropy, loss_mask=response_mask, loss_agg_mode=loss_agg_mode)"}, {"line": 475, "text": ""}, {"line": 476, "text": "                        # compute policy loss"}, {"line": 477, "text": "                        policy_loss = pg_loss - entropy_loss * entropy_coeff"}, {"line": 478, "text": "                    else:"}, {"line": 479, "text": "                        policy_loss = pg_loss"}, {"line": 480, "text": ""}, {"line": 481, "text": "                    if self.config.use_kl_loss:"}, {"line": 482, "text": "                        ref_log_prob = data[\"ref_log_prob\"]"}, {"line": 483, "text": "                        # compute kl loss"}, {"line": 484, "text": "                        kld = kl_penalty(logprob=log_prob, ref_logprob=ref_log_prob, kl_penalty=self.config.kl_loss_type)"}, {"line": 485, "text": "                        kl_loss = agg_loss(loss_mat=kld, loss_mask=response_mask, loss_agg_mode=loss_agg_mode)"}, {"line": 486, "text": ""}, {"line": 487, "text": "                        policy_loss = policy_loss + kl_loss * self.config.kl_loss_coef"}, {"line": 488, "text": "                        metrics[\"actor/kl_loss\"] = kl_loss.detach().item()"}, {"line": 489, "text": "                        metrics[\"actor/kl_coef\"] = self.config.kl_loss_coef"}, {"line": 490, "text": ""}, {"line": 491, "text": "                    if self.config.use_dynamic_bsz:"}, {"line": 492, "text": "                        # relative to the dynamic bsz"}, {"line": 493, "text": "                        loss = policy_loss * (len(data) / self.config.ppo_mini_batch_size)"}, {"line": 494, "text": "                    else:"}, {"line": 495, "text": "                        loss = policy_loss / self.gradient_accumulation"}, {"line": 496, "text": "                    loss.backward()"}, {"line": 497, "text": ""}, {"line": 498, "text": "                    data = {"}, {"line": 499, "text": "                        \"actor/pg_loss\": pg_loss.detach().item(),"}, {"line": 500, "text": "                        \"actor/pg_clipfrac\": pg_clipfrac.detach().item(),"}, {"line": 501, "text": "                        \"actor/ppo_kl\": ppo_kl.detach().item(),"}, {"line": 502, "text": "                        \"actor/pg_clipfrac_lower\": pg_clipfrac_lower.detach().item(),"}, {"line": 503, "text": "                    }"}, {"line": 504, "text": "                    append_to_dict(metrics, data)"}, {"line": 505, "text": ""}, {"line": 506, "text": "                grad_norm = self._optimizer_step()"}, {"line": 507, "text": "                data = {\"actor/grad_norm\": grad_norm.detach().item()}"}, {"line": 508, "text": "                append_to_dict(metrics, data)"}, {"line": 509, "text": "        self.actor_optimizer.zero_grad()"}, {"line": 510, "text": "        return metrics"}]}}, "config_original_lines": []}
