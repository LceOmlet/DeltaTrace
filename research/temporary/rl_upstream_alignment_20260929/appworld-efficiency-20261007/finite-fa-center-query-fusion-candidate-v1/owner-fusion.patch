+// Default-off owner extension. All existing exported ABIs above keep their
+// original three launches; only this independent row ABI selects Phase 3.
+static int launch_finite_row_fused(FiniteParams p,void *stream_ptr) {
+    using E=mctlass::bfloat16_t;
+    if(p.batch<1||p.heads<1||p.kv_heads<1||p.heads%p.kv_heads!=0||p.length<1)return -1;
+    if(!p.query_starts||!p.coefficient_starts||p.query_length<1)return -2;
+    dim3 grid((p.query_length+CachedTraits::kBlockM-1)/CachedTraits::kBlockM,p.batch*p.heads);
+    constexpr int shared=(size(typename CachedTraits::SmemLayoutQ{})+size(typename CachedTraits::SmemLayoutKV{}))*sizeof(E);
+    auto stream=reinterpret_cast<cudaStream_t>(stream_ptr);
+    deltatrace_fa_finite_p1_kernel<3,CachedTraits><<<grid,CachedTraits::kNThreads,shared,stream>>>(p);
+    auto error=cudaGetLastError();if(error!=cudaSuccess)return int(error);
+    deltatrace_fa_finite_p1_kernel<2,CachedTraits><<<grid,CachedTraits::kNThreads,shared,stream>>>(p);
+    return int(cudaGetLastError());
+}
