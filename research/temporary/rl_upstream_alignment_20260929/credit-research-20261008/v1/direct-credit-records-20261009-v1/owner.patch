+    def _record_joint_dt_batch(self, batch, detail):
+        """Persist returned CPU data only; no model, DT, or credit computation."""
+        directory = getattr(self, '_diagnostic_directory', None)
+        if directory is None:
+            return
+        from pathlib import Path
+        started = time.perf_counter()
+        rows = []
+        for index, item in enumerate(batch):
+            audit = detail['per_sample'][index] if len(batch) > 1 else detail
+            rows.append(dict(
+                trajectory_index=item['index'], traj_uid=str(item['row'].get('traj_uid', '')),
+                reward=item['reward'], prompt_length=item['prompt_length'],
+                input_ids=item['selected'].clone(),
+                suffix_positions=item['suffix_positions'].clone(),
+                policy_mask=item['policy'].clone(), target_mask=item['target'].clone(),
+                prior_source_mask=item['prior'].clone(),
+                source_log_ratios=item['ratios'].clone(),
+                target_offsets=list(item['target_offsets']),
+                factual_target_logp=audit.get('factual_target_logp'),
+                reference_target_logp=audit.get('reference_target_logp')))
+        destination = Path(directory) / f'joint-{time.time_ns()}.pt'
+        torch.save(dict(task=self.task, eos_token_id=self.tokenizer.eos_token_id,
+                        readout_source=__file__, rows=rows), destination)
+        print('[DT direct joint record] ' + json.dumps(dict(
+            path=str(destination), bytes=destination.stat().st_size,
+            trajectories=len(rows), seconds=time.perf_counter()-started)), flush=True)
+
